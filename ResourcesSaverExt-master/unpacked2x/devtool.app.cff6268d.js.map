{
  "name": "cstudio-edit-clone",
  "version": "3.0.0",
  "description": "CStudio - Edit & Clone: Visually edit any website and download the source code locally.",
  "browserslist": [
    "> 0.5%, last 2 versions, not dead"
  ],
  "repository": "git@github.com:sakshamwadhankar/CStudio.git",
  "author": "sakshamwadhankar",
  "license": "GPL-3.0+",
  "scripts": {
    "dev": "npm run cp && parcel watch ./src/*.html --no-hmr --dist-dir unpacked2x",
    "dev-serve": "npm run cp && parcel ./src/*.html --port 20987 --dist-dir unpacked2x",
    "build": "npm run cp && parcel build ./src/*.html --dist-dir unpacked2x",
    "cp": "node scripts/build-prep.js",
    "clean": "node -e \"const fs = require('fs'); ['dist', 'unpacked2x', '.parcel-cache'].forEach(d => fs.rmSync(d, {recursive: true, force: true}))\"",
    "reset": "npm run clean && node -e \"fs.rmSync('.cache', {recursive: true, force: true})\"",
    "local": "node -e \"fs.rmSync('node_modules/parcel-plugin-local', {recursive: true, force: true})\" && npm install && npm run reset",
    "auto": "node -e \"fs.rmSync('output', {recursive: true, force: true})\" && babel-node auto.js --presets @babel/preset-env",
    "prettier": "prettier --write ."
  },
  "alias": {
    "devtoolApp": "./src/devtoolApp",
    "components": "./src/components"
  },
  "parcelExternals": [
    "fonts/**/*",
    "vendors/**/*"
  ],
  "dependencies": {
    "@zip.js/zip.js": "^2.6.26",
    "app": "^0.1.0",
    "context": "^3.0.4",
    "global": "^4.4.0",
    "lodash": "^4.17.21",
    "polished": "^4.2.2",
    "prettier": "^2.7.1",
    "react": "^18.2.0",
    "react-dom": "^18.2.0",
    "react-icons": "^4.4.0",
    "react-spring": "^9.5.4",
    "reset-css": "^5.0.1",
    "store": "^2.0.12",
    "styled-components": "^5.3.5"
  },
  "devDependencies": {
    "@babel/core": "^7.19.1",
    "@babel/node": "^7.22.19",
    "@babel/preset-env": "^7.19.1",
    "@babel/preset-react": "^7.18.6",
    "@parcel/config-default": "^2.7.0",
    "@parcel/plugin": "^2.7.0",
    "@parcel/transformer-raw": "^2.7.0",
    "@parcel/transformer-sass": "^2.7.0",
    "parcel": "^2.7.0",
    "parcel-namer-resource-saver": "file:./plugins/parcel-namer-resource-saver",
    "puppeteer": "^21.3.8",
    "sass": "^1.54.9"
  }
}